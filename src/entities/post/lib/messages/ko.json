    {
      "declarations": ["input place"],
      "selectors": ["place"],
      "match": {
        "place=comment": "댓글에서 멘션했습니다",
        "place=*": "설명에서 멘션했습니다"
      }
    }
  ],
  "event_mentioned_user": [
    {
      "declarations": ["input place", "input name"],
      "selectors": ["place"],
      "match": {
        "place=comment": "댓글에서 {name}님을 멘션했습니다",
        "place=*": "설명에서 {name}님을 멘션했습니다"
