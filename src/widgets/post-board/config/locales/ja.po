#: src/widgets/post-board/ui/PostBoard.tsx
msgid "{count, plural, other {#건}}"
msgstr "{count, plural, other {#件}}"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "{key} 카드를 집었습니다. 화살표로 열을 옮기고 Space로 놓습니다."
msgstr "{key} のカードを持ち上げました。矢印キーで列を移動し、Space で置きます。"

#. {key}는 게시물 키, {toName}은 옮기려던 상태 이름
#: src/widgets/post-board/ui/PostBoard.tsx
msgid "{key}을(를) {toName}(으)로 옮기지 못했습니다: {reason}"
msgstr "{key} を {toName} に移動できませんでした: {reason}"

#. {label}은 보드 칸 이름(상태, 스윔레인이면 '팀 · 상태')
#: src/widgets/post-board/ui/PostBoard.tsx
msgid "{label} {count, plural, other {#건}}"
msgstr "{label} {count, plural, other {#件}}"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "{label} 열 위"
msgstr "{label} 列の上"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "{label} 열에 놓았습니다."
msgstr "{label} 列に置きました。"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "Space로 카드를 집고, 화살표로 열을 옮긴 뒤 Space로 놓습니다. Esc는 취소, Enter는 카드 열기입니다."
msgstr "Space でカードを持ち上げ、矢印キーで列を移動してから Space で置きます。Esc でキャンセル、Enter でカードを開きます。"

#. 숫자 바로 뒤에 붙는다. 영어는 앞에 공백을 둔다
#: src/widgets/post-board/ui/PostBoard.tsx
msgctxt "unit after a card's comment count"
msgid "개 댓글"
msgstr "件のコメント"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "놓을 열이 없어 그대로 둡니다."
msgstr "置ける列がないため、そのままにします。"

#: src/widgets/post-board/ui/PostBoard.tsx
msgctxt "blocked post icon"
msgid "막힘"
msgstr "ブロック中"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgctxt "confirm: reject"
msgid "반려"
msgstr "却下"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgid "반려 사유 (댓글로 남습니다)"
msgstr "却下の理由 (コメントとして残ります)"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgid "반려: {title}"
msgstr "却下: {title}"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgctxt "confirm: put on hold"
msgid "보류"
msgstr "保留"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgid "보류: {title}"
msgstr "保留: {title}"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgid "사유"
msgstr "理由"

#: src/widgets/post-board/ui/move-dialogs.tsx
msgid "사유를 고르세요"
msgstr "理由を選んでください"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "옮기기를 취소했습니다."
msgstr "移動をキャンセルしました。"

#: src/widgets/post-board/ui/PostBoard.tsx
msgid "옮길 수 있는 카드"
msgstr "移動できるカード"

#: src/widgets/post-board/ui/move-dialogs.tsx
