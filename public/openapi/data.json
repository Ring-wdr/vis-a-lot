{
  "openapi": "3.1.0",
  "info": {
    "title": "vis-a-lot data service",
    "description": "데이터셋 적재(등록)와 데이터셋 메타 조회",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/data"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ColumnSummary": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["range"]
              },
              "column": {
                "$ref": "#/components/schemas/ColumnName"
              },
              "type": {
                "type": "string",
                "enum": ["numeric", "datetime"]
              },
              "min": {
                "type": ["number", "null"]
              },
              "max": {
                "type": ["number", "null"]
              },
              "nullCount": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "column",
              "type",
              "min",
              "max",
              "nullCount",
              "count"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["values"]
              },
              "column": {
                "$ref": "#/components/schemas/ColumnName"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number"
                    }
                  },
                  "required": ["value", "count"]
                }
              },
              "nullCount": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            },
            "required": ["kind", "column", "values", "nullCount", "count"]
          }
        ]
      },
      "ColumnName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "example": "factory"
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "unknown chart"
          }
        },
        "required": ["error"]
      },
      "DatasetId": {
        "type": "string",
        "enum": ["iot"]
      },
      "DatasetStatus": {
        "type": "object",
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/RowSize"
          },
          "state": {
            "type": "string",
            "enum": ["missing", "generating", "ready"]
          },
          "phase": {
            "type": "string",
            "enum": ["copy", "analyze"]
          },
          "done": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "generateMs": {
            "type": "number"
          }
        },
        "required": ["rows", "state", "done", "total"]
      },
      "RowSize": {
        "anyOf": [
          {
            "type": "number",
            "enum": [100000]
          },
          {
            "type": "number",
            "enum": [500000]
          },
          {
            "type": "number",
            "enum": [1000000]
          }
        ]
      },
      "GenerateDatasetRequest": {
        "type": "object",
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/RowSize"
          }
        },
        "required": ["rows"]
      },
      "DataHealth": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["data"]
          },
          "db": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "bootCount": {
                "type": "number"
              },
              "bootMs": {
                "type": "number"
              }
            },
            "required": ["version", "bootCount", "bootMs"]
          }
        },
        "required": ["service", "db"]
      },
      "LegendValuesResponse": {
        "type": "object",
        "properties": {
          "column": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["column", "values"]
      },
      "DatasetListResponse": {
        "type": "object",
        "properties": {
          "datasets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetStatus"
            }
          }
        },
        "required": ["datasets"]
      },
      "DatasetSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/RowSize"
          },
          "ready": {
            "type": "boolean"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnInfo"
            }
          }
        },
        "required": ["rows", "ready", "columns"]
      },
      "ColumnInfo": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ColumnType"
          },
          "nullable": {
            "type": "boolean"
          },
          "distinct": {
            "type": ["number", "null"]
          }
        },
        "required": ["name", "label", "type", "nullable", "distinct"]
      },
      "ColumnType": {
        "type": "string",
        "enum": ["categorical", "numeric", "datetime"]
      },
      "SplitCountResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "exact": {
            "type": "boolean"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": ["count", "exact", "limit"]
      },
      "SplitCountRequest": {
        "type": "object",
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/RowSize"
          },
          "cols": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnName"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChartFilter"
            },
            "maxItems": 200
          }
        },
        "required": ["rows", "cols"]
      },
      "ChartFilter": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/RangeFilter"
          },
          {
            "$ref": "#/components/schemas/ExcludeFilter"
          }
        ]
      },
      "RangeFilter": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["range"]
          },
          "column": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "inverse": {
            "type": "boolean"
          },
          "includeNull": {
            "type": "boolean"
          }
        },
        "required": ["kind", "column", "min", "max", "inverse", "includeNull"]
      },
      "ExcludeFilter": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["exclude"]
          },
          "column": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50000
          }
        },
        "required": ["kind", "column", "values"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/datasets/{datasetId}/columns/{column}/summary": {
      "get": {
        "tags": ["datasets"],
        "summary": "필터용 컬럼 요약: 숫자·시계열은 범위와 null 수, 범주는 값별 행 수",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/ColumnName"
            },
            "required": true,
            "name": "column",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "enum": [100000, 500000, 1000000]
            },
            "required": true,
            "name": "rows",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "컬럼 요약",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColumnSummary"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "데이터셋이 아직 준비되지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/generate": {
      "post": {
        "tags": ["datasets"],
        "summary": "데이터 적재(등록). 이미 있거나 만드는 중이면 현재 상태만 돌려준다",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateDatasetRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "현재 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetStatus"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["ops"],
        "responses": {
          "200": {
            "description": "상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataHealth"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/legend-values": {
      "get": {
        "tags": ["datasets"],
        "summary": "legend 컬럼의 전체 값 목록",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "enum": [100000, 500000, 1000000]
            },
            "required": true,
            "name": "rows",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/ColumnName"
            },
            "required": true,
            "name": "column",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "legend 값",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegendValuesResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "데이터셋이 아직 준비되지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}": {
      "get": {
        "tags": ["datasets"],
        "summary": "행 수별 적재 상태",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "행 수별 상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetListResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/schema": {
      "get": {
        "tags": ["datasets"],
        "summary": "데이터셋 스키마: 적재된 테이블에서 읽은 컬럼과 타입(categorical / numeric / datetime). 적재 중에도 알 수 있다",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "enum": [100000, 500000, 1000000]
            },
            "required": true,
            "name": "rows",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "컬럼 목록",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetSchema"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "등록하지 않은 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/split-count": {
      "post": {
        "tags": ["datasets"],
        "summary": "split 조합 개수 (최대 개수 초과 검사). 필터가 있으면 필터를 적용해 센다",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SplitCountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "조합 개수",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SplitCountResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "데이터셋이 아직 준비되지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
