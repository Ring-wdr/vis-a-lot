{
  "openapi": "3.1.0",
  "info": {
    "title": "vis-a-lot data service",
    "description": "데이터셋 적재(등록)와 데이터셋 메타 조회",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/data"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CsvCheck": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "number"
          },
          "skipped": {
            "type": "number"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "$ref": "#/components/schemas/ColumnType"
                },
                "inferred": {
                  "$ref": "#/components/schemas/ColumnType"
                },
                "included": {
                  "type": "boolean"
                },
                "invalid": {
                  "type": "number"
                }
              },
              "required": ["name", "type", "inferred", "included", "invalid"]
            }
          }
        },
        "required": ["rows", "skipped", "columns"]
      },
      "ColumnType": {
        "type": "string",
        "enum": ["categorical", "numeric", "datetime"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "unknown chart"
          }
        },
        "required": ["error"]
      },
      "CheckUploadRequest": {
        "type": "object",
        "properties": {
          "options": {
            "$ref": "#/components/schemas/CsvOptions"
          }
        },
        "required": ["options"]
      },
      "CsvOptions": {
        "type": "object",
        "properties": {
          "delimiter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          "header": {
            "type": "boolean"
          },
          "nullValue": {
            "type": "string",
            "maxLength": 20
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          "encoding": {
            "type": "string",
            "enum": ["auto", "utf-8", "euc-kr"]
          },
          "datetimeFormat": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 40
          },
          "ignoreErrors": {
            "type": "boolean"
          },
          "types": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ColumnType"
            }
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "delimiter",
          "header",
          "nullValue",
          "quote",
          "encoding",
          "datetimeFormat",
          "ignoreErrors"
        ]
      },
      "ColumnSummary": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["range"]
              },
              "column": {
                "$ref": "#/components/schemas/ColumnName"
              },
              "type": {
                "type": "string",
                "enum": ["numeric", "datetime"]
              },
              "min": {
                "type": ["number", "null"]
              },
              "max": {
                "type": ["number", "null"]
              },
              "nullCount": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "column",
              "type",
              "min",
              "max",
              "nullCount",
              "count"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["values"]
              },
              "column": {
                "$ref": "#/components/schemas/ColumnName"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number"
                    }
                  },
                  "required": ["value", "count"]
                }
              },
              "nullCount": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            },
            "required": ["kind", "column", "values", "nullCount", "count"]
          }
        ]
      },
      "ColumnName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "example": "factory"
      },
      "DatasetId": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$",
        "example": "iot-100k"
      },
      "UploadTask": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "parse",
              "queued",
              "copy",
              "analyze",
              "done",
              "rejected",
              "failed"
            ]
          },
          "done": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "version": {
            "type": "number"
          },
          "datasetId": {
            "$ref": "#/components/schemas/DatasetId"
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["state", "done", "total", "version"]
      },
      "CommitUploadRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "options": {
            "$ref": "#/components/schemas/CsvOptions"
          }
        },
        "required": ["name", "options"]
      },
      "DatasetStatus": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DatasetId"
          },
          "kind": {
            "type": "string",
            "enum": ["sample", "upload"]
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["missing", "generating", "ready", "failed"]
          },
          "phase": {
            "type": "string",
            "enum": ["copy", "analyze"]
          },
          "done": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "generateMs": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadInfo"
          }
        },
        "required": ["id", "kind", "name", "state", "done", "total"]
      },
      "UploadInfo": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                }
              },
              "required": ["name", "size"]
            }
          },
          "createdAt": {
            "type": "number"
          },
          "options": {
            "$ref": "#/components/schemas/CsvOptions"
          },
          "inferred": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "$ref": "#/components/schemas/ColumnType"
                }
              },
              "required": ["name", "type"]
            }
          }
        },
        "required": [
          "fileName",
          "size",
          "files",
          "createdAt",
          "options",
          "inferred"
        ]
      },
      "DataHealth": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["data"]
          },
          "db": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "bootCount": {
                "type": "number"
              },
              "bootMs": {
                "type": "number"
              }
            },
            "required": ["version", "bootCount", "bootMs"]
          }
        },
        "required": ["service", "db"]
      },
      "LegendValuesResponse": {
        "type": "object",
        "properties": {
          "column": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["column", "values"]
      },
      "DatasetListResponse": {
        "type": "object",
        "properties": {
          "datasets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DatasetStatus"
            }
          }
        },
        "required": ["datasets"]
      },
      "CsvPreview": {
        "type": "object",
        "properties": {
          "raw": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "inferred": {
                  "$ref": "#/components/schemas/ColumnType"
                },
                "type": {
                  "$ref": "#/components/schemas/ColumnType"
                }
              },
              "required": ["name", "inferred", "type"]
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": ["string", "null"]
              }
            }
          },
          "invalid": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["raw", "columns", "rows", "invalid"]
      },
      "PreviewUploadRequest": {
        "type": "object",
        "properties": {
          "file": {
            "type": "integer",
            "minimum": 0
          },
          "options": {
            "$ref": "#/components/schemas/CsvOptions"
          }
        },
        "required": ["file", "options"]
      },
      "RenameDatasetRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": ["name"]
      },
      "DatasetSchema": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DatasetId"
          },
          "ready": {
            "type": "boolean"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnInfo"
            }
          }
        },
        "required": ["id", "ready", "columns"]
      },
      "ColumnInfo": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ColumnType"
          },
          "nullable": {
            "type": "boolean"
          },
          "distinct": {
            "type": ["number", "null"]
          }
        },
        "required": ["name", "label", "type", "nullable", "distinct"]
      },
      "SplitCountResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "exact": {
            "type": "boolean"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": ["count", "exact", "limit"]
      },
      "SplitCountRequest": {
        "type": "object",
        "properties": {
          "cols": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnName"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChartFilter"
            },
            "maxItems": 200
          }
        },
        "required": ["cols"]
      },
      "ChartFilter": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/RangeFilter"
          },
          {
            "$ref": "#/components/schemas/ExcludeFilter"
          }
        ]
      },
      "RangeFilter": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["range"]
          },
          "column": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "inverse": {
            "type": "boolean"
          },
          "includeNull": {
            "type": "boolean"
          }
        },
        "required": ["kind", "column", "min", "max", "inverse", "includeNull"]
      },
      "ExcludeFilter": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["exclude"]
          },
          "column": {
            "$ref": "#/components/schemas/ColumnName"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50000
          }
        },
        "required": ["kind", "column", "values"]
      },
      "StagedUpload": {
        "type": "object",
        "properties": {
          "stageId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                }
              },
              "required": ["name", "size"]
            }
          },
          "dataset": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/DatasetId"
              },
              "name": {
                "type": "string"
              },
              "options": {
                "$ref": "#/components/schemas/CsvOptions"
              }
            },
            "required": ["id", "name", "options"]
          }
        },
        "required": ["stageId", "fileName", "size", "files"]
      },
      "StageUploadRequest": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": ["file"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/datasets/staging/{stageId}/check": {
      "post": {
        "tags": ["datasets"],
        "summary": "적재하지 않고 파일 전체를 검사한다: 행 수, 컬럼별 타입과 변환 불가 값 수",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^st-[a-z0-9]{1,20}$"
            },
            "required": true,
            "name": "stageId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "검사 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsvCheck"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "CSV 검사에서 거절 (옵션·스키마 오류, 올려 둔 파일 없음 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}/columns/{column}/summary": {
      "get": {
        "tags": ["datasets"],
        "summary": "필터용 컬럼 요약: 숫자·시계열은 범위와 null 수, 범주는 값별 행 수",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/ColumnName"
            },
            "required": true,
            "name": "column",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "컬럼 요약",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColumnSummary"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "데이터셋이 아직 준비되지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/staging/{stageId}/commit": {
      "post": {
        "tags": ["datasets"],
        "summary": "올려 둔 파일을 적재한다. 검사·변환부터 백그라운드에서 하고 진행은 task long polling으로 받는다",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^st-[a-z0-9]{1,20}$"
            },
            "required": true,
            "name": "stageId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitUploadRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "적재 시작",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadTask"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "CSV 검사에서 거절 (옵션·스키마 오류, 올려 둔 파일 없음 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/datasets/{datasetId}": {
      "get": {
        "tags": ["datasets"],
        "summary": "데이터셋 하나의 적재 상태",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/DatasetId"
            },
            "required": true,
            "name": "datasetId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "상태",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetStatus"
                }
              }
            }
          },
          "400": {
            "description": "요청 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "토큰 없음, 만료, 위조",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "scope 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "모르는 데이터셋",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["datasets"],
        "summary": "업로드한 데이터셋 삭제",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
