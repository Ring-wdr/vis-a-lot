{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/dist",
      "!**/build",
      "!apps/web/public/mockServiceWorker.js",
      "!apps/web/public/*.svg",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!.claude/worktrees",
      "!.agents"
    ]
  },
  "plugins": [
    "./biome-plugins/tailwind-classes.grit",
    "./biome-plugins/tailwind-scale.grit"
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        },
        "useTailwindShorthandClasses": {
          "level": "error",
          "fix": "safe"
        },
        "noTailwindLegacyUtilities": "error",
        "noTailwindRawColors": "error",
        "useTailwindStaticClassStrings": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noFloatingPromises": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/*/src/**",
        "packages/shared/**",
        "!apps/web/src/application/MockServerProvider.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@server/**", "**/server/**"],
                    "message": "화면은 서버 코드를 import하지 않는다. OAS에서 생성한 @/shared/api/types를 쓴다."
                  },
                  {
                    "group": ["**/*.module.css"],
                    "message": "스타일은 Tailwind 클래스로 쓴다. 토큰·reset은 packages/shared/ui/globals.css 한 곳에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "tailwind": {
    "stylesheet": "./packages/shared/ui/globals.css",
    "mergeFunctions": ["cn"],
    "variantFunctions": ["tv"]
  }
}
