{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!public/mockServiceWorker.js"
    ]
  },
  "plugins": ["./biome-plugins/tailwind-classes.grit"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "functions": ["cn", "tv"]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/application/MockServerProvider.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@server/**", "**/server/**"],
                    "message": "화면은 서버 코드를 import하지 않는다. OAS에서 생성한 @/shared/api/types를 쓴다."
                  },
                  {
                    "group": ["**/*.module.css"],
                    "message": "스타일은 Tailwind 클래스로 쓴다. 토큰·reset은 app/globals.css 한 곳에 둔다."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
