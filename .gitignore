# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (루트와 각 앱·패키지의 node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (앱마다 apps/<앱>/.next, apps/<앱>/out)
/.next/
/out/
apps/*/.next/
apps/*/out/

# production
/build
apps/*/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lingui 컴파일 결과. 앱은 i18n:compile·dev, 패키지는 build 태스크가 lingui compile로 만든다 (turbo.json outputs). .po는 커밋한다.
apps/*/src/**/config/locales/*.ts
apps/*/src/application/messages.*.ts
packages/*/config/locales/*.ts

# turbo 로컬 캐시·로그 (루트와 각 앱·패키지의 .turbo)
.turbo/
