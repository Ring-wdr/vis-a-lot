{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "turbo run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/help/_next/:path*", "destination": "/_next/:path*" }
  ]
}
