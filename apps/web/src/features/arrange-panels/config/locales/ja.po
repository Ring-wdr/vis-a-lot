#: src/features/arrange-panels/model/arrange.ts
msgid "{count, plural, other {마지막 칸 #개가 지워집니다.}} 지워지는 칸의 차트는 다시 볼 수 없습니다. 레이아웃을 바꿀까요?"
msgstr "{count, plural, other {最後のパネル#個が削除されます。}}削除されるパネルのチャートは元に戻せません。レイアウトを変更しますか?"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "{panels, plural, other {#칸}}"
msgstr "{panels, plural, other {#パネル}}"

#: src/features/arrange-panels/model/arrange.ts
msgid "그리는 칸이 있어 레이아웃을 바꿀 수 없습니다. 그리기가 끝나거나 취소한 뒤에 바꿔 주세요."
msgstr "描画中のパネルがあるためレイアウトを変更できません。描画が終わるかキャンセルしてから変更してください。"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "레이아웃"
msgstr "レイアウト"

#: src/features/arrange-panels/model/arrange.ts
msgid "레이아웃 바꾸기"
msgstr "レイアウトの変更"

#: src/features/arrange-panels/model/arrange.ts
msgid "마지막 칸은 지울 수 없습니다."
msgstr "最後のパネルは削除できません。"

#: src/features/arrange-panels/model/arrange.ts
msgid "모든 칸과 그린 차트를 지우고 빈 칸 하나로 되돌립니다. 그리는 중인 칸은 취소합니다."
msgstr "すべてのパネルと描画したチャートを削除し、空のパネル1つに戻します。描画中のパネルはキャンセルします。"

#: src/features/arrange-panels/ui/ClearBoardButton.tsx
msgid "모든 칸을 지우고 빈 칸 하나로 되돌립니다"
msgstr "すべてのパネルを削除し、空のパネル1つに戻します"

#: src/features/arrange-panels/model/arrange.ts
msgctxt "confirm button"
msgid "바꾸기"
msgstr "変更"

#: src/features/arrange-panels/model/arrange.ts
#: src/features/arrange-panels/ui/ClearBoardButton.tsx
msgid "보드 비우기"
msgstr "ボードを空にする"

#: src/features/arrange-panels/ui/AddPanelButton.tsx
msgid "보드에 빈 칸을 더합니다"
msgstr "ボードに空のパネルを追加します"

#: src/features/arrange-panels/model/arrange.ts
msgctxt "confirm button"
msgid "비우기"
msgstr "空にする"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "아래 큰 칸 + 위 2칸"
msgstr "下に大 + 上に2つ"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "오른쪽 큰 칸 + 왼쪽 2칸"
msgstr "右に大 + 左に2つ"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "왼쪽 큰 칸 + 오른쪽 2칸"
msgstr "左に大 + 右に2つ"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "왼쪽 큰 칸 + 오른쪽 3칸"
msgstr "左に大 + 右に3つ"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "위 큰 칸 + 아래 2칸"
msgstr "上に大 + 下に2つ"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "위 큰 칸 + 아래 3칸"
msgstr "上に大 + 下に3つ"

#: src/features/arrange-panels/model/arrange.ts
msgctxt "confirm button"
msgid "지우기"
msgstr "削除"

#: src/features/arrange-panels/model/arrange.ts
msgid "칸 {n}의 차트가 함께 지워집니다. 지울까요?"
msgstr "パネル{n}のチャートも削除されます。削除しますか?"

#: src/features/arrange-panels/ui/LayoutPresetButton.tsx
msgid "칸 배치를 고릅니다"
msgstr "パネルの配置を選びます"

#: src/features/arrange-panels/model/arrange.ts
msgid "칸 지우기"
msgstr "パネルを削除"

#: src/features/arrange-panels/ui/AddPanelButton.tsx
