{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "vis-a-lot-web": {
      "packageName": "@vis-a-lot/web",
      "development": {
        "local": 3000,
        "fallback": "vis-a-lot-web.vercel.app"
      }
    },
    "vis-a-lot-help": {
      "packageName": "@vis-a-lot/help",
      "assetPrefix": "help-assets",
      "development": {
        "local": 3001
      },
      "routing": [
        {
          "group": "help",
          "paths": ["/help", "/help/:path*", "/help-assets/:path*"]
        }
      ]
    }
  },
  "options": {
    "localProxyPort": 3024
  }
}
