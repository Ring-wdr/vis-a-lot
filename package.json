{
  "name": "vis-a-lot",
  "version": "0.18.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@vis-a-lot/web",
    "dev:help": "turbo run dev --filter=@vis-a-lot/help",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@vis-a-lot/web",
    "build:help": "turbo run build --filter=@vis-a-lot/help",
    "lint": "turbo run lint lint:fsd lint:biome lint:css",
    "lint:root": "turbo run lint:fsd lint:biome lint:css",
    "check:affected": "pnpm run lint:root && TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/develop} turbo run lint test typecheck build --affected",
    "lint:fsd": "node scripts/check-fsd.mjs",
    "lint:biome": "biome check",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "biome format --write",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen:api": "pnpm --filter @vis-a-lot/web gen:api",
    "gen:api:check": "pnpm --filter @vis-a-lot/web gen:api:check",
    "prepare": "husky",
    "bench:db": "pnpm --filter @vis-a-lot/web bench:db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "husky": "9.1.7",
    "stylelint": "17.16.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.14.0"
}
