{
  "name": "vis-a-lot",
  "version": "0.18.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @vis-a-lot/web dev",
    "dev:help": "pnpm --filter @vis-a-lot/help dev",
    "build": "pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" build",
    "build:web": "pnpm --filter @vis-a-lot/web build",
    "build:help": "pnpm --filter @vis-a-lot/help build",
    "lint": "node scripts/check-fsd.mjs && pnpm -r --workspace-concurrency=1 lint && biome check && stylelint \"**/*.css\"",
    "lint:fsd": "node scripts/check-fsd.mjs",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "biome format --write",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "gen:api": "pnpm --filter @vis-a-lot/web gen:api",
    "gen:api:check": "pnpm --filter @vis-a-lot/web gen:api:check",
    "prepare": "husky",
    "bench:db": "pnpm --filter @vis-a-lot/web bench:db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "husky": "9.1.7",
    "stylelint": "17.16.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
}
